# Copy to .env (gitignored) and fill in. Dagster's commands and dbt (1.12+) load it automatically.
# Credentials only. The database is NOT set here: `make dev` / `make prod` choose it via NFL_ENV
# (a value in .env would override what you type in the shell, because Dagster's .env wins).
# Absolute key path: neither dbt-snowflake nor dagster-snowflake expands "~".
# Account identifier: <orgname>-<accountname>, e.g. myorg-myaccount
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=NFL_SVC
SNOWFLAKE_PRIVATE_KEY_PATH=/absolute/path/to/nfl_dagster_key.p8
SNOWFLAKE_ROLE=NFL_ROLE
SNOWFLAKE_WAREHOUSE=NFL_WH
